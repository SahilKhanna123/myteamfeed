{
  "manifest_version": 3,
  "name": "MyTeamFeed · Live Score",
  "version": "1.0.0",
  "description": "Floating live score widget for your MLB team — works on any page.",
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://site.api.espn.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["widget.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "MyTeamFeed Score"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
  {
    "resources": ["logos/mlb/*.png"],
    "matches": ["<all_urls>"]
  }
]
}

 
